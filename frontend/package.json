{
  "name": "ca-pharmacy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest",
    "lint": "eslint assets/js --ext .js --fix",
    "lint:check": "eslint assets/js --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "ci": "npm run format:check && npm run lint:check && npm run test -- --run && npm run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^2.13.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.2",
    "vite": "^5.4.19",
    "vitest": "^1.6.1"
  }
}
